# Puerto publicado por LangGraph en el Mac/VPS.
LANGGRAPH_PORT=2024

# --- Proveedor LLM ---
# Para usar OpenClaw en el Mac antiguo mediante el túnel SSH:
NAYAX_LLM_PROVIDER=openclaw_gateway
OPENCLAW_GATEWAY_URL=http://host.docker.internal:18789/v1
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_MODEL=openclaw/nayax-langgraph-bridge
OPENCLAW_GATEWAY_TIMEOUT_SECONDS=120

# --- Visión de facturas ---
# invoice-upload-test hereda estas variables mediante su compose.yaml.
# OCR local, sin API: se ejecuta antes de cualquier proveedor de visión.
INVOICE_TESSERACT_ENABLED=true
INVOICE_TESSERACT_LANGUAGES=spa+eng
INVOICE_VISION_PROVIDER=openclaw_gateway
# Vacío = utiliza OPENCLAW_GATEWAY_MODEL.
INVOICE_VISION_MODEL=

# Alternativa para VPS: OpenAI API.
# NAYAX_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
NAYAX_LLM_MODEL=gpt-5.4-mini
NAYAX_LLM_TEMPERATURE=0
NAYAX_LLM_TIMEOUT_SECONDS=30
MAX_MACHINE_FETCH_CONCURRENCY=4
# Valores por defecto del workflow pricing. Studio puede sustituirlos por input.
PRICING_DEFAULT_PROVIDER_ID=distribuidora-mayorista
PRICING_DEFAULT_PROVIDER_SOURCE=api

# --- LangSmith ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=nayax-agents-langgraph

# --- Nayax Lynx ---
NODE_ENV=production
LOG_LEVEL=info
NAYAX_BASE_URL=https://qa-lynx.nayax.com
NAYAX_API_PREFIX=/operational/v1
NAYAX_TOKEN=
NAYAX_OPERATOR_ID=0
NAYAX_TIMEOUT_MS=15000
NAYAX_MAX_RETRIES=2

# --- Seguridad de nayax-bridge ---
API_KEYS=
MAX_PRICE_CHANGE_RATIO=0.30
WRITES_ENABLED=false
MCP_WRITES_REQUIRE_DRY_RUN=true
CACHE_TTL_SECONDS=60

# --- Proveedor de márgenes ---
DISTRIBUIDORA_MAYORISTA_BASE_URL=https://distribucionmayorista.online
DISTRIBUIDORA_MAYORISTA_EMAIL=
DISTRIBUIDORA_MAYORISTA_PASSWORD=
DISTRIBUIDORA_MAYORISTA_WISHLIST_ID=
