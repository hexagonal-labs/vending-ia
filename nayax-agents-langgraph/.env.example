NAYAX_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
NAYAX_LLM_MODEL=gpt-5.4-mini
NAYAX_LLM_TEMPERATURE=0
NAYAX_LLM_TIMEOUT_SECONDS=30

# OAuth local mediante el OpenClaw Gateway. No guardar el token en Git.
# Los scripts run-openclaw-*.sh lo obtienen del config local de OpenClaw.
# No dejes OPENCLAW_GATEWAY_TOKEN= vacío: puede sobrescribir el token que el
# script inyecta al arrancar LangGraph Studio.
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789/v1
# OPENCLAW_GATEWAY_TOKEN=solo_para_ejecuciones_manual_con_token_exportado
OPENCLAW_GATEWAY_MODEL=openclaw/nayax-langgraph-bridge
OPENCLAW_GATEWAY_TIMEOUT_SECONDS=120

# LangSmith Studio y trazabilidad de ejecuciones.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=nayax-agents-langgraph

# Ruta absoluta al proyecto nayax-bridge ya compilado.
NAYAX_BRIDGE_DIR=/ruta/absoluta/a/nayax-bridge
NAYAX_NODE_COMMAND=node

# SQLite local para checkpoints de conversaciones.
NAYAX_CHECKPOINT_DB=data/checkpoints.db
# Máximo de máquinas consultadas simultáneamente por el workflow pricing.
MAX_MACHINE_FETCH_CONCURRENCY=4
# API consulta al proveedor antes de comparar; catalog usa precios de facturas ya importadas.
PRICING_DEFAULT_PROVIDER_ID=distribuidora-mayorista
PRICING_DEFAULT_PROVIDER_SOURCE=api

# Credenciales del proveedor de márgenes (fase pricing).
DISTRIBUIDORA_MAYORISTA_BASE_URL=https://distribucionmayorista.online
DISTRIBUIDORA_MAYORISTA_EMAIL=
DISTRIBUIDORA_MAYORISTA_PASSWORD=
DISTRIBUIDORA_MAYORISTA_WISHLIST_ID=
