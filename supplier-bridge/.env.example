# Distribuidora Mayorista
DISTRIBUIDORA_MAYORISTA_BASE_URL=https://distribucionmayorista.online
DISTRIBUIDORA_MAYORISTA_EMAIL=
DISTRIBUIDORA_MAYORISTA_PASSWORD=
DISTRIBUIDORA_MAYORISTA_WISHLIST_ID=

# Política explícita de la API: ajustar con el proveedor antes de producción.
# false significa que el bridge suma ese componente al coste neto publicado.
DISTRIBUIDORA_MAYORISTA_PRICE_INCLUDES_VAT=false
DISTRIBUIDORA_MAYORISTA_PRICE_INCLUDES_EQUIVALENCE_SURCHARGE=false
DISTRIBUIDORA_MAYORISTA_VAT_RATE=0.21
DISTRIBUIDORA_MAYORISTA_EQUIVALENCE_SURCHARGE_RATE=0.052
