# --- Entorno ---
NODE_ENV=development
LOG_LEVEL=debug

# --- Servidor HTTP ---
HTTP_PORT=3000
HTTP_HOST=0.0.0.0

# --- Nayax Lynx ---
# QA:   https://qa-lynx.nayax.com
# PROD: https://lynx.nayax.com
NAYAX_BASE_URL=https://qa-lynx.nayax.com
NAYAX_API_PREFIX=/operational/v1
NAYAX_TOKEN=pon-aqui-tu-token-de-lynx
NAYAX_OPERATOR_ID=0
NAYAX_TIMEOUT_MS=15000
NAYAX_MAX_RETRIES=2

# --- Seguridad de NUESTRA API (no la de Nayax) ---
# Formato: clave:rol,clave:rol   Roles: viewer | operator | agent
API_KEYS=dev-viewer-key:viewer,dev-operator-key:operator,dev-agent-key:agent

# --- Reglas de negocio ---
# Variacion maxima de precio permitida sin confirmacion explicita (0.30 = 30%)
MAX_PRICE_CHANGE_RATIO=0.30
# Poner en false para bloquear TODAS las escrituras (modo solo lectura)
WRITES_ENABLED=true
# Si es true, las herramientas MCP de escritura solo permiten dry-run
MCP_WRITES_REQUIRE_DRY_RUN=false

# --- Cache ---
CACHE_TTL_SECONDS=60
