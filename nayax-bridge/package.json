{
  "name": "nayax-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "API puente sobre Nayax Lynx. Nucleo unico consumido via HTTP (frontend) y via MCP (agentes de IA).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:mcp": "tsx src/mcp.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:mcp": "node dist/mcp.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "undici": "^7.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
